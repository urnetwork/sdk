        { "op": "update", "prompt": "stopped", "action": "", "shown": "" }
      ]
    },
    {
      "name": "a dismissed prompt that ends and returns shows again",
      "steps": [
        { "op": "update", "prompt": "upgrade", "action": "post", "shown": "upgrade" },
        { "op": "dismiss", "action": "remove", "shown": "" },
        { "op": "update", "prompt": "", "action": "", "shown": "" },
        { "op": "update", "prompt": "upgrade", "action": "update", "shown": "upgrade" }
      ]
    },
    {
      "name": "sign out withdraws it, clears a dismissal, and the next sign-in alerts again",
      "steps": [
        { "op": "update", "prompt": "upgrade", "action": "post", "shown": "upgrade" },
        { "op": "reset", "action": "remove", "shown": "" },
        { "op": "update", "prompt": "upgrade", "action": "post", "shown": "upgrade" },
        { "op": "dismiss", "action": "remove", "shown": "" },
        { "op": "reset", "action": "", "shown": "" },
